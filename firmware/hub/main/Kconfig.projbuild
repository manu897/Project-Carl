menu "Carl Hub configuration"

config CARL_WIFI_SSID
    string "Home Wi-Fi SSID"
    default "carl-hub-needs-config"
    help
        SSID of the home Wi-Fi network the hub joins. The captive-portal
        first-boot flow (Phase 3f, queued) will replace this with NVS-stored
        credentials entered through a phone — for now, set via menuconfig
        before flashing.

config CARL_WIFI_PASSWORD
    string "Home Wi-Fi password"
    default ""
    help
        WPA2 password. Leave empty for an open network (not recommended).

config CARL_MDNS_HOSTNAME
    string "mDNS hostname"
    default "carl-hub"
    help
        Hub answers as <hostname>.local on the LAN. iOS app + M5Paper reader
        discover via the _carl-hub._tcp service record this hostname owns.

config CARL_HTTP_PORT
    int "HTTP server port"
    default 80
    range 1 65535
    help
        Port for the OpenAPI server. Default 80 keeps URLs clean for users
        opening http://carl-hub.local/ in a browser.

config CARL_TEST_NODE_MAC
    string "Test sensor-node MAC (AA:BB:CC:DD:EE:FF, uppercase)"
    default ""
    help
        BLE MAC of a sensor node whose advertisements the hub should
        decrypt. Read from nRF Connect mobile app while scanning, or off
        the back of the XIAO if the chip is labelled. Phase 3c replaces
        this with a proper POST /api/keys provisioning endpoint backed by
        NVS — for now, hardcoded one-node entry.

config CARL_TEST_NODE_KEY
    string "Test sensor-node AES-CCM key (32-char lowercase hex)"
    default ""
    help
        16-byte AES-CCM key, lowercase hex (e.g. 4b1f9c8a3e2d6f70b15c4d8a9e3f2c10).
        Read off the sensor's OLED on first boot, or from the QR code.
        Empty string disables BLE-scan decrypt (hub still serves /api/nodes
        as []).

config CARL_TEST_NODE2_MAC
    string "Second test node MAC (AA:BB:CC:DD:EE:FF, uppercase)"
    default ""
    help
        BLE MAC of a second sensor node (e.g. a Thingy:53 room node).
        Leave empty to skip. Phase 3c replaces both test-node entries
        with a proper POST /api/keys provisioning endpoint.

config CARL_TEST_NODE2_KEY
    string "Second test node AES-CCM key (32-char lowercase hex)"
    default ""
    help
        AES key for the second test node. Same format as CARL_TEST_NODE_KEY.

menu "Home Assistant MQTT bridge (optional)"

config CARL_MQTT_HA_ENABLE
    bool "Publish readings to Home Assistant over MQTT"
    default n
    help
        Bridge node readings to a local MQTT broker using Home Assistant's
        MQTT Discovery so each plant appears automatically in HA. Opt-in —
        Carl works standalone without it.

config CARL_MQTT_HA_BROKER_URI
    string "MQTT broker URI"
    default "mqtt://homeassistant.local:1883"
    depends on CARL_MQTT_HA_ENABLE
    help
        e.g. mqtt://192.168.1.10:1883 (or mqtts:// for TLS).

config CARL_MQTT_HA_USERNAME
    string "MQTT username (optional)"
    default ""
    depends on CARL_MQTT_HA_ENABLE

config CARL_MQTT_HA_PASSWORD
    string "MQTT password (optional)"
    default ""
    depends on CARL_MQTT_HA_ENABLE

config CARL_MQTT_HA_DISCOVERY_PREFIX
    string "HA discovery prefix"
    default "homeassistant"
    depends on CARL_MQTT_HA_ENABLE

config CARL_MQTT_HA_INTERVAL_SEC
    int "Publish interval (s)"
    default 60
    range 10 3600
    depends on CARL_MQTT_HA_ENABLE

endmenu

menu "Project-Norman cloud uplink (optional)"

config CARL_NORMAN_ENABLE
    bool "Stream readings to Project-Norman over MQTT"
    default n
    help
        Continuously publish node readings to Project-Norman's MQTT broker
        (cloud ingestion / ML). Opt-in. Uses TLS when the URI is mqtts://.

config CARL_NORMAN_BROKER_URI
    string "Norman MQTT broker URI"
    default "mqtts://norman.example.com:8883"
    depends on CARL_NORMAN_ENABLE

config CARL_NORMAN_USERNAME
    string "Norman MQTT username / device token"
    default ""
    depends on CARL_NORMAN_ENABLE

config CARL_NORMAN_PASSWORD
    string "Norman MQTT password / secret"
    default ""
    depends on CARL_NORMAN_ENABLE

config CARL_NORMAN_SITE_ID
    string "Site / hub identifier (topic namespace)"
    default "carl-hub"
    depends on CARL_NORMAN_ENABLE
    help
        Readings publish to carl/<site>/<node_id>. Distinguishes multiple
        hubs uploading to the same Norman account.

config CARL_NORMAN_INTERVAL_SEC
    int "Publish interval (s)"
    default 30
    range 5 3600
    depends on CARL_NORMAN_ENABLE

endmenu

endmenu
