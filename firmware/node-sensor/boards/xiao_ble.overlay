/* Devicetree overlay for the XIAO nRF52840 sensor node.
 *
 * Wires the soil-moisture probe (ADC), the I2C ambient bus (BME280, VEML7700,
 * and on the display profile the SSD1306 OLED), the buzzer (PWM), and the
 * user button. The display profile pulls in the OLED + buzzer + button
 * paths in firmware (guarded by CONFIG_CARL_DISPLAY_PROFILE); the cheap
 * profile leaves those device nodes present but unused.
 */

/ {
    aliases {
        carl-buzzer = &buzzer_pwm;
        carl-button = &user_button;
        carl-soil   = &soil_adc;
        carl-oled   = &ssd1306;
    };

    /* Soil moisture probe wired to AIN0 (P0.02 / Grove A0 on the expansion
     * board). Read via &adc using zephyr,user io-channels. */
    zephyr,user {
        io-channels = <&adc 0>;
    };

    pwmleds {
        compatible = "pwm-leds";
        buzzer_pwm: buzzer_pwm {
            pwms = <&pwm0 0 PWM_HZ(2000) PWM_POLARITY_NORMAL>;
        };
    };

    buttons {
        compatible = "gpio-keys";
        user_button: user_button {
            gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "User button (D1)";
        };
    };

    /* Synthetic node so src/sensors.cpp can DT_NODELABEL(soil_adc). */
    soil_adc: soil_adc {
        compatible = "voltage-divider";
        io-channels = <&adc 0>;
        output-ohms = <0>;
        full-ohms   = <1>;
    };
};

&adc {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    bme280: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
    };

    veml7700: veml7700@10 {
        compatible = "vishay,veml7700";
        reg = <0x10>;
    };

    /* SSD1306 OLED on the XIAO Expansion Board. The driver init is gated
     * behind CONFIG_CARL_DISPLAY_PROFILE in firmware. */
    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width  = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset    = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep      = <0x22>;
        segment-remap;
        com-invdir;
    };
};

&pwm0 {
    status = "okay";
};
