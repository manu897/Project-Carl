/* Devicetree overlay for the XIAO nRF52840 sensor node.
 *
 * Wires the soil-moisture probe (ADC), the Grove I2C bus (BME280, VEML7700,
 * and on the display profile the SSD1306 OLED), the buzzer (PWM), and the
 * user button. The display profile pulls in the OLED + buzzer + button
 * paths in firmware (guarded by CONFIG_CARL_DISPLAY_PROFILE); the cheap
 * profile leaves those device nodes present but unused.
 *
 * Notes on choices:
 *   - The Grove I2C bus on D4/D5 is `i2c1` in the upstream board (see
 *     boards/arm/xiao_ble/xiao_ble_common.dtsi). `i2c0` exists but isn't
 *     enabled — using i2c1 means we don't have to redefine pinctrl.
 *   - `pwm0` is already consumed by the onboard red-LED PWM. We use `pwm1`
 *     for the buzzer with its own pinctrl block (channel 0 → A3 / P0.29).
 *   - `&adc` is enabled by the board; we just add a channel for the soil
 *     probe and expose it via the standard `zephyr,user` node.
 */

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    aliases {
        carl-buzzer = &buzzer_pwm;
        carl-button = &user_button;
        carl-oled   = &ssd1306;
    };

    /* Soil moisture probe wired to AIN0 (P0.02 / Grove A0 on the expansion
     * board). Read via &adc using zephyr,user io-channels. */
    zephyr,user {
        io-channels = <&adc 0>;
    };

    pwmleds {
        compatible = "pwm-leds";
        buzzer_pwm: buzzer_pwm {
            pwms = <&pwm1 0 PWM_HZ(2000) PWM_POLARITY_NORMAL>;
        };
    };

    buttons {
        compatible = "gpio-keys";
        user_button: user_button {
            gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "User button (D1)";
        };
    };
};

&pinctrl {
    /* Buzzer on A3 (D3 = P0.29). Distinct from pwm0_default to avoid
     * conflicting with the onboard red-LED PWM. */
    pwm1_default: pwm1_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 29)>;
        };
    };
    pwm1_sleep: pwm1_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 29)>;
            low-power-enable;
        };
    };
};

&adc {
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };
};

&i2c1 {
    clock-frequency = <I2C_BITRATE_FAST>;

    bme280: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
    };

    veml7700: veml7700@10 {
        compatible = "vishay,veml7700";
        reg = <0x10>;
    };

    /* SSD1306 OLED on the XIAO Expansion Board. The driver init is gated
     * behind CONFIG_CARL_DISPLAY_PROFILE in firmware. */
    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width  = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset    = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep      = <0x22>;
        segment-remap;
        com-invdir;
    };
};

&pwm1 {
    status = "okay";
    pinctrl-0 = <&pwm1_default>;
    pinctrl-1 = <&pwm1_sleep>;
    pinctrl-names = "default", "sleep";
};
